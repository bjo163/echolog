  "dependencies": {
    "@echolog/contract": "workspace:*",
    "@echolog/shared": "workspace:*",
    "@smithy/signature-v4": "5.7.4",
    "@smithy/types": "4.19.0",
    "fastify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}