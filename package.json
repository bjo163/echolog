{
  "name": "echolog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ECHOLOG — standalone content-addressed object storage with a bounded S3-compatible subset",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "user:add": "tsx --env-file-if-exists=.env src/cli/user-add.ts"
  },
  "dependencies": {
    "@smithy/signature-v4": "5.7.4",
    "@smithy/types": "4.19.0",
    "fastify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
