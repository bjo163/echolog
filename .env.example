# ECHOLOG configuration. Copy to .env and fill in the secrets locally.
# Never commit a real .env: .gitignore excludes it.
# The service reads this file through `node --env-file-if-exists=.env`.

# --- Listen address -----------------------------------------------------------
# Loopback is the intended binding; put a TLS proxy in front for anything public.
ECHOLOG_HOST=127.0.0.1
ECHOLOG_PORT=3006
# development | test | production. production requires GRANT_SECRET and S3_BUCKET.
NODE_ENV=development

# --- Storage volume -----------------------------------------------------------
# One directory holds objects/, metadata/, s3-keys/, private-witness/ and tmp/.
ECHOLOG_STORAGE_ROOT=./data/echolog
ECHOLOG_STORAGE_QUOTA_BYTES=10737418240
ECHOLOG_MAX_UPLOAD_BYTES=52428800
# Comma-separated MIME allow-list. Anything outside it is refused with 415.
ECHOLOG_ALLOWED_MIME_TYPES=application/octet-stream,application/pdf,application/zip,audio/flac,audio/mpeg,audio/mp4,audio/ogg,audio/wav,image/gif,image/jpeg,image/png,image/webp,video/mp4

# --- Identity store (node:sqlite) --------------------------------------------
ECHOLOG_DATABASE_PATH=./data/echolog/echolog.db
# Session lifetime in hours; the service caps it at 90 days.
ECHOLOG_SESSION_TTL_HOURS=168
# auto | true | false. auto sets the Secure flag only in production.
ECHOLOG_COOKIE_SECURE=auto

# First-boot administrator. Both or neither, at least 12 characters of password.
# Prefer `pnpm user:add` once the instance exists, then clear these.
ECHOLOG_ADMIN_LOGIN=
ECHOLOG_ADMIN_PASSWORD=

# Signs download grants. At least 32 characters, required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ECHOLOG_GRANT_SECRET=

# --- Bounded S3-compatible endpoint ----------------------------------------
# One path-style bucket. Both credentials or neither; a bucket needs both.
ECHOLOG_S3_BUCKET=
ECHOLOG_S3_REGION=us-east-1
ECHOLOG_S3_ACCESS_KEY_ID=
ECHOLOG_S3_SECRET_ACCESS_KEY=

# --- Federation with a MoonWitness Hub (both optional) ----------------------
# Leave ECHOLOG_ARSY_URL empty and this service decides authentication alone:
# local ecl_ keys, local operator sessions, and its own administrator rule for
# private-witness digests.
#
# Set it (absolute http(s) URL) and a bearer that is not an ecl_ key is resolved
# by the Hub's GET /api/v1/auth/me; for those Hub subjects the Hub's
# POST /api/v1/witness/private-media-authorize answer alone decides reads of a
# marked digest. Local credentials are never forwarded to the Hub.
ECHOLOG_ARSY_URL=

# Shared daemon credential for the `x-echolog-key` header. 32-256 characters.
# Empty disables that mode entirely. Generate one:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ECHOLOG_SERVICE_KEY=

# --- Used only by `pnpm user:add` --------------------------------------------
# Keeps a new password out of shell history. Unset it right after the command.
ECHOLOG_USER_PASSWORD=
